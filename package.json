  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-worklets": "0.10.1",
    "react-query-kit": "^3.3.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~57.0.13",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-design-system": "workspace:*",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "start": "APP_ENV=development expo start",
    "start:staging": "APP_ENV=staging expo start",
    "start:production": "APP_ENV=production expo start",
    "prebuild": "APP_ENV=development expo prebuild --clean",
    "prebuild:staging": "APP_ENV=staging expo prebuild --clean",
    "prebuild:production": "APP_ENV=production expo prebuild --clean",
    "prebuild:development": "APP_ENV=development expo prebuild --clean",
    "android": "APP_ENV=development expo run:android",
    "android:staging": "APP_ENV=staging expo run:android --variant release",
    "android:production": "APP_ENV=production expo run:android --variant release",
    "ios": "APP_ENV=development expo run:ios",
    "ios:staging": "APP_ENV=staging expo run:ios --configuration Release",
    "ios:production": "APP_ENV=production expo run:ios --configuration Release",
    "build:development:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:development:android": "npx eas-cli@latest build --profile development --platform android",
    "build:staging:ios": "npx eas-cli@latest build --profile staging --platform ios",
    "build:staging:android": "npx eas-cli@latest build --profile staging --platform android",
    "build:production:ios": "npx eas-cli@latest build --profile production --platform ios",
    "build:production:android": "npx eas-cli@latest build --profile production --platform android",
    "publish:appdist:staging:ios": "bash scripts/publish-appdist.sh staging ios",
    "publish:appdist:staging:android": "bash scripts/publish-appdist.sh staging android",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "check-all": "pnpm lint && pnpm type-check",
    "doctor": "npx expo-doctor",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
