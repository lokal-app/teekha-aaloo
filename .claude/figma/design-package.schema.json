{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-package.schema.json",
  "title": "design-package.json — output of figma-extractor (stage 1 of /figma-implement)",
  "type": "object",
  "required": ["source", "tokens", "components", "screens", "flows", "unmapped"],
  "additionalProperties": false,
  "properties": {
    "source": {
      "type": "object",
      "required": ["fileKey", "version", "extractedAt"],
      "properties": {
        "fileKey": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "extractedAt": { "type": "string", "minLength": 1 },
        "url": { "type": "string" }
      }
    },
    "tokens": {
      "type": "object",
      "required": ["palette", "semantic", "spacing", "typography", "radius", "shadows"],
      "properties": {
        "palette": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" } },
        "semantic": {
          "type": "object",
          "required": ["light", "dark"],
          "properties": {
            "light": { "type": "object", "additionalProperties": { "type": "string" } },
            "dark": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "spacing": { "type": "object", "additionalProperties": { "type": "number" } },
        "typography": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["fontSize", "lineHeight", "fontWeight"],
            "properties": {
              "fontFamily": { "type": "string" },
              "fontSize": { "type": "number" },
              "lineHeight": { "type": "number" },
              "fontWeight": { "type": "string" },
              "letterSpacing": { "type": "number" }
            }
          }
        },
        "radius": { "type": "object", "additionalProperties": { "type": "number" } },
        "shadows": { "type": "object", "additionalProperties": { "type": "object" } }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["figmaName", "variants"],
        "properties": {
          "figmaName": { "type": "string" },
          "primitive": { "type": ["string", "null"] },
          "variants": { "type": "array", "items": { "type": "string" } },
          "states": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frameName", "nodeId"],
        "properties": {
          "frameName": { "type": "string" },
          "nodeId": { "type": "string" },
          "path": { "type": ["string", "null"] },
          "navigator": { "type": ["string", "null"] }
        }
      }
    },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "trigger": { "type": "string" }
        }
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "figmaName"],
        "properties": {
          "kind": { "enum": ["token", "component", "screen"] },
          "figmaName": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
